{
    "name": "devaction/ui",
    "description": "DevAction UI: componentes Blade para Laravel/Livewire com Tailwind CSS v4 e ícones Hugeicons Stroke Rounded.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "livewire",
        "blade",
        "tailwindcss",
        "ui-kit"
    ],
    "homepage": "https://github.com/devaction-labs/ui",
    "authors": [
        {
            "name": "DevAction Labs",
            "homepage": "https://github.com/devaction-labs"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "livewire/livewire": "^4.1",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-livewire": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "suggest": {
        "livewire/blaze": "Compila os componentes em funções PHP otimizadas (^1.0)"
    },
    "autoload": {
        "psr-4": {
            "DevAction\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DevAction\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DevAction\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": "pint --parallel",
        "test:lint": "pint --parallel --test",
        "test:types": "phpstan analyse --memory-limit=1G",
        "test:unit": "pest --parallel",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
